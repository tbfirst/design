<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tbfirst</groupId>
        <artifactId>tbfirst</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tbfirst-auth</artifactId>
    <name>tbfirst-auth</name>
    <description>认证服务：注册 / 登录 / Token 颁发与刷新（Servlet MVC 栈）</description>

    <dependencies>
        <!-- ============ tbfirst 公共库 ============ -->
        <!-- 通用响应 / 异常 / 常量 -->
        <dependency>
            <groupId>com.tbfirst</groupId>
            <artifactId>tbfirst-common-core</artifactId>
        </dependency>
        <!-- 全局异常处理 / CORS（仅 AutoConfiguration 装配，需要业务服务自己引 starter-web） -->
        <dependency>
            <groupId>com.tbfirst</groupId>
            <artifactId>tbfirst-common-web</artifactId>
        </dependency>
        <!-- JwtUtil / UserContextHolder -->
        <dependency>
            <groupId>com.tbfirst</groupId>
            <artifactId>tbfirst-common-security</artifactId>
        </dependency>
        <!-- BaseEntity / JPA 审计 -->
        <dependency>
            <groupId>com.tbfirst</groupId>
            <artifactId>tbfirst-common-datasource</artifactId>
        </dependency>
        <!-- RedisTemplate 配置 / 分布式锁 -->
        <dependency>
            <groupId>com.tbfirst</groupId>
            <artifactId>tbfirst-common-redis</artifactId>
        </dependency>
        <!-- TraceId Filter -->
        <dependency>
            <groupId>com.tbfirst</groupId>
            <artifactId>tbfirst-common-log</artifactId>
        </dependency>
        <!-- Feign 默认配置（Request.Options 180s / TraceId 透传） -->
        <dependency>
            <groupId>com.tbfirst</groupId>
            <artifactId>tbfirst-common-feign</artifactId>
        </dependency>

        <!-- ============ Spring Boot Starter 应用层 ============ -->
        <!-- Web MVC：Tomcat 容器 + Spring MVC + Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验：Hibernate Validator 实现 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- MyBatis-Plus（Spring Boot 3.x 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- Redis（Lettuce 驱动） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Actuator：健康检查端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============ 数据库 ============ -->
        <!-- PostgreSQL JDBC 驱动，仅运行时加载 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway 迁移核心 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 的 PostgreSQL 方言包（10.x 起必须独立引入） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ============ Spring Cloud Alibaba ============ -->
        <!-- OpenFeign：声明式跨服务调用（调 image 聚合生图数量） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- 客户端负载均衡：Feign + lb://tbfirst-image 必需 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Nacos 服务注册与发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心：拉取 tbfirst-common.yaml -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- ============ 其他 ============ -->
        <!-- BCrypt 密码加密，仅用密码编码，不引入 SecurityFilterChain -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- SpringDoc OpenAPI：给 AuthController 生成接口文档 + 内置 swagger-ui -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打可执行 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
