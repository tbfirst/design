SPRING_PROFILES_ACTIVE=dev

# ============ 基础设施 ============
DB_HOST=数据库的地址
DB_PORT=数据库的端口
DB_NAME=数据库的名称
DB_USER=数据库的用户名
DB_PASSWORD=数据库的密码

REDIS_HOST=redis的地址
REDIS_PORT=redis的端口
# todo 如果有设置密码或以后要升级为集群此处要多配置

NACOS_ADDR=nacos的地址
NACOS_NS=nacos的namespace
NACOS_USERNAME=nacos的用户名
NACOS_PASSWORD=nacos的密码

# ============ 安全 ============
JWT_SECRET=实际要使用的密钥
# 7 天；内部员工低频使用，避免 24h 频繁重登
JWT_EXPIRATION_MS=604800000
INTERNAL_TOKEN=tbfirst-internal

# ---- 默认 admin 账号 ----
# init.sql 不预置任何 admin 账号，避免明文/弱口令 hash 进入版本库。
# 生产部署后，请在宿主机执行以下命令生成 bcrypt hash 后 INSERT 进 auth.sys_user：
#   HASH=$(htpasswd -bnBC 12 '' '<新密码>' | tr -d ':\n')
#   docker exec -i tbfirst-postgres-prod psql -U "$DB_USER" -d "$DB_NAME" -c \
#     "INSERT INTO auth.sys_user (username, password_hash, nickname, roles, status) \
#      VALUES ('admin', '$HASH', 'Admin', 'ADMIN,USER', 'active');"
# 上线后请立即登录修改密码，并确保该 hash 不被回写到任何 .sql / .env / git。

# ============ AI Provider ============
GEMINI_API_KEY=对应的apikey
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============ 存储 ============
UPLOADS_PATH=文件本地存储的路径

# 存储后端切换：local（默认，磁盘 + /static/）| gcs（Google Cloud Storage）
STORAGE_PROVIDER=local

# ↓↓↓ 仅 STORAGE_PROVIDER=gcs 时需要填写 ↓↓↓
# GCP 项目 ID（GCP Console → IAM & Admin → Settings 顶部）
GCS_PROJECT_ID=
# 物理桶名（GCP 全局唯一）
GCS_BUCKET=tbfirst-bucket-01
# Service Account JSON 路径（容器内路径）；docker-compose 已挂到 /secrets/gcs-sa.json
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-sa.json
# URL 模式：public（公开桶直链）| presigned（V4 签名 URL，含 TTL）| cdn（Cloud CDN 自定义域名）| proxy（经迷你主机 /img/** 反代，员工不翻墙）
# 生产默认 proxy
GCS_URL_MODE=proxy
# Cloud CDN 自定义域名（仅 GCS_URL_MODE=cdn 时使用），不带 scheme
GCS_CDN_DOMAIN=
# 反代根 URL（仅 GCS_URL_MODE=proxy 时使用），形如 https://yourdomain.com，不带尾 /
GCS_PROXY_BASE_URL=https://yourdomain.com


# ============ Cloudflare Tunnel ============
# Cloudflare Tunnel 控制台获取，见 .ralph/specs/cloudflare-tunnel.md
CLOUDFLARE_TUNNEL_TOKEN=
