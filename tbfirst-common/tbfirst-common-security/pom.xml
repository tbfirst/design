<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 引入父依赖 ———— tbfirst-common（该依赖又引入顶级父依赖 ———— tbfirst-parent） -->
    <parent>
        <groupId>com.tbfirst</groupId>
        <artifactId>tbfirst-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tbfirst-common-security</artifactId>
    <name>tbfirst-common-security</name>
    <description>JWT 工具、用户上下文、Servlet 侧 Filter（不依赖 spring-security starter）</description>

    <!--
        设计原则：
        1. 本模块不引 spring-boot-starter-security，因为我们的鉴权模型是 Gateway 集中验签 + 下游读 Header
        2. 密码编码使用轻量的 spring-security-crypto（只是 BCrypt 算法，不引入 SecurityFilterChain）
        3. Filter 是 Servlet 侧的，Gateway（WebFlux）只复用本模块的 JwtUtil 工具类，不会加载 UserContextFilter
    -->
    <dependencies>
        <!-- tbfirst 内部：响应 / 异常 / 常量 / HTTP Header 键名 -->
        <dependency>
            <groupId>com.tbfirst</groupId>
            <artifactId>tbfirst-common-core</artifactId>
        </dependency>

        <!-- SLF4J API：@Slf4j 注解生成的 log 字段需要此 API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Spring Boot 自动装配 API：本模块的 Filter 需要 @AutoConfiguration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Spring Web：OncePerRequestFilter 基类 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Servlet API：HttpServletRequest / HttpServletResponse，容器提供 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JWT API -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <!-- JWT 实现：HS256 / RS256 算法实现，运行时加载 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JWT Jackson 序列化：claim 转 JSON，运行时加载 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
