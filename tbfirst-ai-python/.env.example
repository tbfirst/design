APP_HOST=0.0.0.0
APP_PORT=8200
APP_NAME=tbfirst-ai-python
LOG_LEVEL=INFO

# Nacos
NACOS_ADDR=localhost:8848
NACOS_NS=dev
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Postgres (RAG / pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tbfirst
DB_USER=tbfirst
DB_PASSWORD=tbfirst

# AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini 模型降级链（逗号分隔；留空 = 用 app/services/model_chain.py 中的 DEFAULT_*_CHAIN）
# 任一模型 429/5xx/404/安全阻断/超时 → 自动尝试下一个；
# 调用方（如 Phase0 Asset / Phase2 Color / Inpaint）可额外前置 pro 做质量偏好。
# 示例：
#   GEMINI_IMAGE_CHAIN=gemini-3.1-flash-image-preview,gemini-3-pro-image-preview,gemini-2.5-flash-image-preview
#   GEMINI_TEXT_CHAIN=gemini-3-flash-preview,gemini-2.5-flash
#   GEMINI_DNA_CHAIN=gemini-3-flash-preview,gemini-2.5-flash
GEMINI_IMAGE_CHAIN=
GEMINI_TEXT_CHAIN=
GEMINI_DNA_CHAIN=

# Internal auth
INTERNAL_TOKEN=tbfirst-internal

# Image service (tbfirst-image microservice)
IMAGE_SERVICE_URL=http://tbfirst-image:8102

# Design Agent
DESIGN_AGENT_ENABLED=true
AGENT_DB_POOL_MIN_SIZE=1
AGENT_DB_POOL_MAX_SIZE=10
AGENT_DB_POOL_TIMEOUT_SECONDS=10
AGENT_EXECUTION_LEASE_SECONDS=120
AGENT_REQUEST_DEDUPE_SECONDS=86400
TBFIRST_MCP_GATEWAY_URL=http://localhost:8000
TBFIRST_MCP_AUTH_MODE=header
TBFIRST_MCP_TOKEN_SECRET=
TBFIRST_MCP_TOKEN_MAP=
TBFIRST_MCP_REQUIRE_EMPLOYEE_MAPPING=true
TBFIRST_MCP_HTTP_TIMEOUT_SECONDS=120
TBFIRST_MCP_RETRY_ATTEMPTS=3
TBFIRST_MCP_CIRCUIT_INITIAL_OPEN_SECONDS=10
TBFIRST_MCP_CIRCUIT_MAX_OPEN_SECONDS=60
TBFIRST_MCP_TOOL_TIMEOUT_SECONDS=240
TBFIRST_MCP_MAX_IMAGES_PER_CALL=5
TBFIRST_MCP_MAX_IMAGE_BYTES=10485760
TBFIRST_MCP_ALLOWED_IMAGE_HOSTS=
TBFIRST_MCP_MAX_PROMPT_CHARS=4000
TBFIRST_MCP_AUDIT_ENABLED=true
TBFIRST_MCP_AUDIT_PATH=logs/design_tool_audit.jsonl
TBFIRST_MCP_USER_DAILY_DEFAULT=100
TBFIRST_MCP_GROUP_DAILY_DEFAULT=1000
TBFIRST_MCP_QUOTA_PERIOD_SECONDS=86400
TBFIRST_MCP_ENABLED_TOOLS=tbfirst_check_workspace,tbfirst_create_adimage_set,tbfirst_image_phase2_refine,tbfirst_image_phase2_color,tbfirst_image_phase3_banner
